---
interface Props { name: 'instagram' | 'linkedin' | 'email' | 'photo' | 'pdf' | 'pin' | 'up'; }
const { name } = Astro.props;
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
  {name === 'linkedin' && <><path d="M5 9v12M5 4v.1M10 21V9h4v2c1-3 7-3 7 2v8M14 21v-7" stroke-width="3" /></>}
  {name === 'email' && <><rect x="2" y="4" width="20" height="16" rx="1" /><path d="m3 6 9 7 9-7" /></>}
  {name === 'photo' && <><path d="M3 7h4l2-3h6l2 3h4v14H3z" /><circle cx="12" cy="13" r="4" /></>}
  {name === 'pdf' && <><path d="M6 2h8l5 5v15H6zM14 2v6h5M9 17l6-6M9 12l6 6" /></>}
  {name === 'pin' && <><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'up' && <path d="m6 14 6-6 6 6" />}
</svg>
