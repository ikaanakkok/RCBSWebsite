---
interface Props { label: string; heading: string; image?: string; imageAlt?: string; }
const { label, heading, image, imageAlt = '' } = Astro.props;
---
<header class="wrap page-head">
  <p class="page-label">{label}</p>
  <h1>{heading}</h1>
</header>
{image && <div class="wrap"><img class="page-image" src={image} alt={imageAlt} width="1170" height="520" /></div>}
