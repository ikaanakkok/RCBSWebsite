---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { formatDate, readingMinutes, splitId, t } from '../../../i18n/ui';
import page from '../../../data/pages/blog.json';
export async function getStaticPaths() {
  const all = await getCollection('magazine', e => !e.data.draft);
  return all.map(article => {
    const { lang, slug } = splitId(article.id);
    const twin = article.data.translationKey
      ? all.find(other => splitId(other.id).lang !== lang && other.data.translationKey === article.data.translationKey)
      : undefined;
    return { params: { lang, slug }, props: { article, twinId: twin?.id } };
  });
}
interface Props { article: CollectionEntry<'magazine'>; twinId?: string; }
const { article, twinId } = Astro.props;
const { lang } = splitId(article.id);
const other = lang === 'tr' ? 'en' : 'tr';
const tr = t(lang);
const { title, author, date, category, excerpt, cover, coverAlt } = article.data;
const { Content } = await render(article);
const altHref = twinId ? `/${other}/blog/${splitId(twinId).slug}/` : `/${other}/blog/`;
---
<Base lang={lang} title={title} description={excerpt} altHref={altHref}>
  <article class="wrap post">
    <header class="post-head">
      <a class="back" href={`/${lang}/blog/`}>{page[lang].backLabel}</a>
      <p class="kicker">{category}</p>
      <h1>{title}</h1>
      <p class="lead">{excerpt}</p>
      <p class="post-meta">{tr('magazine.by')} <strong>{author}</strong> · <time datetime={date.toISOString()}>{formatDate(date, lang)}</time> · {readingMinutes(article.body)} {tr('magazine.minRead')}</p>
    </header>
    {cover && <img src={cover} alt={coverAlt} class="post-cover" width="1170" height="700" fetchpriority="high" />}
    <div class="prose post-body"><Content /></div>
  </article>
</Base>
<style>
  .post-head { text-align: center; max-width: 900px; margin-inline: auto; padding: 2.5rem 0 2rem; }
  .back { display: inline-block; margin-bottom: 2rem; font-size: 1rem; }
  .post-head h1 { margin: 1rem 0 1.4rem; overflow-wrap: anywhere; }
  .post-meta { font-size: 1rem; color: var(--muted); }
  .post-cover { width: 100%; max-height: 650px; object-fit: cover; margin: 1.5rem 0 3rem; }
  .post-body { margin: 1.5rem auto 0; }
</style>
