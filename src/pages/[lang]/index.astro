---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { langPaths, type Lang } from '../../i18n/ui';
import club from '../../data/site.json';
import page from '../../data/pages/home.json';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const copy = page[lang];
---
<Base lang={lang}>
  <section class:list={['hero', { 'hero--logo': !copy.heroImage }]} aria-label={copy.heroTitle}>
    {copy.heroImage
      ? <img class="hero-image" src={copy.heroImage} alt={copy.heroImageAlt} style={{objectPosition: copy.heroPosition}} width="1600" height="700" fetchpriority="high" />
      : <img class:list={['hero-logo', {'logo-inverted': club.invertLogo}]} src={club.logo} alt={club.name[lang]} width="296" height="256" fetchpriority="high" />}
    <h1 class="sr-only">{copy.heroTitle}</h1>
    <div class="marquee" aria-hidden="true"><div class="marquee-track">{[0, 1, 2, 3].map(() => <span>{copy.heroTitle} ·&nbsp;</span>)}</div></div>
    <button class="motion-control" type="button" aria-label={copy.motionPauseLabel} aria-pressed="false" data-pause-label={copy.motionPauseLabel} data-play-label={copy.motionPlayLabel} hidden>
      <svg class="pause-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="3" /></svg>
      <svg class="play-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 4 12 8-12 8z" fill="currentColor" /></svg>
    </button>
  </section>
  <section class="introduction wrap">
    <p class="intro-label">{copy.introLabel}</p>
    <h2>{copy.tagline}</h2>
    <div class="intro-text">{copy.paragraphs.map(p => <p>{p}</p>)}</div>
    <a class="btn" href={`/${lang}/${copy.ctaLink}/`}><Icon name="photo" />{copy.ctaLabel}</a>
  </section>
</Base>
<script>
  const button = document.querySelector<HTMLButtonElement>('.motion-control');
  const track = document.querySelector<HTMLElement>('.marquee-track');
  if (button && track) {
    button.hidden = false;
    track.classList.add('motion-ready');
    button.addEventListener('click', () => {
      const paused = button.getAttribute('aria-pressed') !== 'true';
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', (paused ? button.dataset.playLabel : button.dataset.pauseLabel) ?? '');
      track.dataset.paused = String(paused);
    });
  }
</script>
<style>
  .hero { height: 500px; position: relative; isolation: isolate; overflow: hidden; background: #222; display: grid; place-items: center; }
  .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero::after { content: ''; position: absolute; inset: 55% 0 0; background: linear-gradient(transparent, #0008); z-index: -1; }
  .hero-logo { width: 320px; max-width: 62vw; margin-bottom: 50px; }
  .logo-inverted { filter: url(#logo-alpha) invert(1); mix-blend-mode: screen; }
  .marquee { position: absolute; bottom: 28px; left: 0; width: 100%; overflow: hidden; }
  .marquee-track { width: max-content; display: flex; }
  .marquee-track.motion-ready { animation: marquee 50s linear infinite; }
  .marquee span { font-family: var(--font-display); font-size: clamp(2.6rem, 5vw, 4.2rem); font-weight: 700; line-height: 1.25; white-space: nowrap; text-transform: uppercase; }
  .hero:hover .marquee-track, .hero:focus-within .marquee-track, .marquee-track[data-paused='true'] { animation-play-state: paused; }
  .motion-control { position: absolute; bottom: 4px; right: 12px; display: grid; place-items: center; width: 36px; height: 30px; padding: 6px; border: 0; border-radius: 2px; color: white; background: #181818cc; cursor: pointer; }
  .motion-control svg { width: 17px; height: 17px; }
  .motion-control .play-icon, .motion-control[aria-pressed='true'] .pause-icon { display: none; }
  .motion-control[aria-pressed='true'] .play-icon { display: block; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  .introduction { text-align: center; max-width: 850px; padding-top: 4.25rem; padding-bottom: 1.5rem; }
  .intro-label { font-family: var(--font-display); font-size: 2.1rem; font-style: italic; font-weight: 700; line-height: 1.25; margin-bottom: 1.7rem; }
  .introduction h2 { margin-bottom: 1.4rem; }
  .intro-text p { margin-bottom: 1.4rem; }
  .introduction .btn { margin-top: .25rem; }
  @media (max-width: 760px) {
    .hero { height: 360px; margin-top: 0; }
    .hero-logo { width: 240px; }
    .marquee { bottom: 24px; }
    .introduction { padding-top: 3rem; }
    .intro-label { font-size: 1.8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .motion-control { display: none; } }
</style>
